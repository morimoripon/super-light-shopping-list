{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-light-shopping-list",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // フロント（web/dist）を同じ Worker から配信する。/api/* 以外は静的ファイル。
  // 同一オリジンになるので CORS 設定が不要。
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopping-list",
      // `npx wrangler d1 create shopping-list` の出力で置き換える
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
